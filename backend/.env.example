NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ventas_ai_saas

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=1d

WHATSAPP_SESSION_PATH=storage/whatsapp
WHATSAPP_PROVIDER=baileys
WHATSAPP_HEADLESS=true
WHATSAPP_RECONNECT_BASE_DELAY_MS=5000
WHATSAPP_RECONNECT_MAX_DELAY_MS=60000
WHATSAPP_RECONNECT_MAX_ATTEMPTS=8
WHATSAPP_WORKER_MONITOR_INTERVAL_MS=60000
WHATSAPP_WORKER_START_STAGGER_MS=3000
HANDOFF_JOB_ENABLED=true
WHATSAPP_COMMANDS_VIA_QUEUE=true
WHATSAPP_COMMAND_WORKER_ENABLED=true
WHATSAPP_COMMAND_CONCURRENCY=1
WHATSAPP_COMMAND_TIMEOUT_MS=120000
WHATSAPP_COMMAND_STALE_MS=300000
WHATSAPP_RECONNECT_MAX_CONCURRENCY=3
WHATSAPP_RECONNECT_MAX_DELAY_MS=60000
WHATSAPP_RECONNECT_JITTER_MS=1000
WHATSAPP_RECONNECT_STABLE_AFTER_MS=60000
WHATSAPP_RECONNECT_COOLDOWN_MS=300000
WHATSAPP_INBOUND_VIA_QUEUE=true
WHATSAPP_OUTBOUND_VIA_QUEUE=true
WHATSAPP_INBOUND_WORKER_ENABLED=true
WHATSAPP_OUTBOUND_WORKER_ENABLED=true
WHATSAPP_INBOUND_CONCURRENCY=5
WHATSAPP_OUTBOUND_CONCURRENCY=3
WHATSAPP_MESSAGE_MAX_ATTEMPTS=3
BAILEYS_AUTH_PATH=storage/baileys
BAILEYS_AUTH_STORE=file
BAILEYS_AUTH_ENCRYPTION_KEY=
BAILEYS_AUTH_DB_BATCH_SIZE=100
BAILEYS_RECONNECT_MAX_ATTEMPTS=5
BAILEYS_RECONNECT_BASE_DELAY_MS=2000
BAILEYS_QR_TTL_MS=60000
WHATSAPP_GATEWAY_LEADER_TTL_MS=30000
WHATSAPP_GATEWAY_LEADER_RENEW_MS=10000
WHATSAPP_GATEWAY_STANDBY_RETRY_MS=5000
WHATSAPP_SESSION_LEASE_TTL_MS=30000
WHATSAPP_SESSION_LEASE_RENEW_MS=10000
WHATSAPP_RESTORE_CONCURRENCY=3
WHATSAPP_RESTORE_DELAY_MS=500
WHATSAPP_RESTORE_SPREAD_MS=30000
WHATSAPP_IDEMPOTENCY_STALE_MS=600000
WHATSAPP_IDEMPOTENCY_RETENTION_DAYS=30

QUEUE_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=nexus
REDIS_CONNECT_TIMEOUT_MS=5000
QUEUE_REMOVE_ON_COMPLETE=1000
QUEUE_REMOVE_ON_FAIL=5000
QUEUE_ATTEMPTS=5
QUEUE_BACKOFF_MS=2000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_AUTO_REPLY=false
