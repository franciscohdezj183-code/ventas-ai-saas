# Backend production example
NODE_ENV=production
PORT=4000
API_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# Database
DB_HOST=db.example.com
DB_PORT=3306
DB_USER=ventas_app
DB_PASSWORD=replace_with_a_strong_database_password
DB_NAME=ventas_ai_saas
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# Security
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=1d
FIELD_ENCRYPTION_KEY=replace_with_at_least_32_random_characters
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# WhatsApp sessions
WHATSAPP_SESSION_PATH=.wwebjs_auth
WHATSAPP_RESTORE_SESSIONS=false
WHATSAPP_IGNORE_GROUPS=true
WHATSAPP_LOCALAUTH_RM_MAX_RETRIES=20
PUPPETEER_EXECUTABLE_PATH=
HANDOFF_JOB_ENABLED=true

# OpenAI
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_AUTO_REPLY=false
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0
